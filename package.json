{
  "name": "feather",
  "productName": "Feather®",
  "version": "1.0.1",
  "description": "Lokale Services, Server-Terminal, Dateiverwaltung und SQL-Client in einer Anwendung.",
  "main": "dist/main/main.js",
  "author": "Kridey",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "build:core": "node scripts/build-core.js",
    "build:app": "node scripts/build-app.js",
    "build": "npm run build:core && npm run build:app",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.js",
    "smoke": "node scripts/smoke-core.js",
    "dist": "npm run typecheck && npm run build && npm run build:plugins && npm run build:jre && electron-builder",
    "test": "node scripts/test-blueprint.js && node scripts/test-remote.js && node scripts/test-modules.js && node scripts/test-backup.js && node scripts/test-saveeye.js && node scripts/test-i18n.js && node scripts/test-plugins.js && node scripts/test-sql.js && node scripts/test-terminal.js && node scripts/test-ui.js && node scripts/test-bot.js",
    "build:plugins": "node scripts/build-plugins.js",
    "build:jre": "node scripts/build-jre.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ftp-srv": "^4.6.3",
    "lucide": "^1.61.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "basic-ftp": "^6.2.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "dev.feather.app",
    "productName": "Feather",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**",
      "dist/renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "core/feather-core.jar",
        "to": "core/feather-core.jar"
      },
      {
        "from": "build/jre",
        "to": "jre"
      },
      {
        "from": "plugins-dist/rainbow-icons.jar",
        "to": "plugins/rainbow-icons.jar"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "LICENSE.de.md",
        "to": "LICENSE.de.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Feather-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    },
    "copyright": "Copyright (c) 2026 Kridey"
  },
  "homepage": "https://github.com/Krideygit/feather-software"
}
