{
  "name": "feather",
  "productName": "Feather®",
  "version": "0.2.0",
  "description": "Lokale Entwicklungs-Services (MariaDB, Webserver, ...) ohne Docker-Overhead.",
  "main": "dist/main/main.js",
  "author": "Kridey",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:core": "node scripts/build-core.js",
    "build:app": "node scripts/build-app.js",
    "build": "npm run build:core && npm run build:app",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.js",
    "smoke": "node scripts/smoke-core.js",
    "dist": "npm run typecheck && npm run build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide": "^1.61.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "dev.feather.app",
    "productName": "Feather",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**",
      "dist/renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "core/feather-core.jar",
        "to": "core/feather-core.jar"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
